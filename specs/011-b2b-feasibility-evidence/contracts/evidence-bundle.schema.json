{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://il-ideation.local/schemas/evidence-bundle.json",
  "title": "EvidenceBundleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "created_at", "task", "profile", "trials"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "task": {
      "type": "object",
      "required": ["task_id", "fingerprint"],
      "properties": {
        "task_id": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "profile": {
      "type": "object",
      "required": ["profile_id", "fingerprint"],
      "properties": {
        "profile_id": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trial_id", "attempt", "state", "artifacts", "grades"],
        "properties": {
          "trial_id": {"type": "string", "format": "uuid"},
          "attempt": {"type": "integer", "minimum": 1},
          "state": {"enum": ["passed", "failed", "error", "timeout", "unrun"]},
          "artifacts": {"type": "array"},
          "grades": {"type": "array"}
        }
      }
    }
  }
}
