{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://il-ideation.local/schemas/evidence-bundle.json",
  "title": "EvidenceBundleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "created_at", "task", "profile", "environment", "trials"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "task": {
      "type": "object",
      "required": ["task_id", "fingerprint", "snapshot_path", "snapshot_sha256", "grader_path", "grader_sha256"],
      "properties": {
        "task_id": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "snapshot_path": {"const": "task.json"},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "grader_path": {"const": "grader/grader.py"},
        "grader_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "profile": {
      "type": "object",
      "required": ["profile_id", "fingerprint", "snapshot_path", "snapshot_sha256"],
      "properties": {
        "profile_id": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "snapshot_path": {"const": "profile.json"},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "platform", "mujoco_version", "sandbox_backend", "snapshot_path", "snapshot_sha256"],
      "properties": {
        "python_version": {"type": "string"},
        "platform": {"type": "string"},
        "mujoco_version": {"type": "string"},
        "sandbox_backend": {"type": "string"},
        "snapshot_path": {"const": "environment.json"},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trial_id", "attempt", "state", "transcript_path", "transcript_sha256", "grades_path", "grades_sha256", "artifacts", "grades"],
        "properties": {
          "trial_id": {"type": "string", "format": "uuid"},
          "attempt": {"type": "integer", "minimum": 1},
          "state": {"enum": ["passed", "failed", "error", "timeout", "unrun"]},
          "transcript_path": {"type": "string"},
          "transcript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "grades_path": {"type": "string"},
          "grades_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "artifacts": {"type": "array"},
          "grades": {"type": "array"}
        }
      }
    }
  }
}
