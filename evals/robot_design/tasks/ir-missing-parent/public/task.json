{
  "task_id": "ir-missing-parent",
  "version": 1,
  "title": "Repair a missing parent-link reference",
  "family": "repair",
  "prompt": "Repair starter/robot.json. The shoulder joint currently references a parent link that does not exist. Preserve the two-link robot, its geometry, inertia, joint axis, limits, and actuator. The final robot.json must have one kinematic root, no invalid link references, compile through the repository RobotDesignIR-to-MJCF compiler, and load in MuJoCo. Do not create additional output files.",
  "starter_dir": "starter",
  "required_outputs": [
    "robot.json"
  ],
  "allowed_tools": [
    "read",
    "edit",
    "write",
    "bash"
  ],
  "constraints": [
    {
      "constraint_id": "valid_link_references",
      "quantity": "invalid_joint_reference_count",
      "operator": "==",
      "value": 0,
      "unit": "count"
    },
    {
      "constraint_id": "single_kinematic_root",
      "quantity": "kinematic_root_count",
      "operator": "==",
      "value": 1,
      "unit": "count"
    },
    {
      "constraint_id": "mujoco_load",
      "quantity": "simulator_load_status",
      "operator": "==",
      "value": "pass",
      "unit": "status"
    }
  ],
  "time_limit_seconds": 600,
  "grader_entrypoint": "protected/ir-missing-parent/grader.py",
  "reference_dir": "protected/ir-missing-parent/reference",
  "seeded_failure_dir": "protected/ir-missing-parent/seeded_failure",
  "seeded_failure_grade_id": "ir.references_valid"
}
