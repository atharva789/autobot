# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Google / Gemini
GEMINI_API_KEY=<your-google-ai-studio-api-key>
YOUTUBE_API_KEY=<your-youtube-data-api-key>

# Research LLM backend
# Use local CLI-backed models for research loops instead of OpenAI API calls.
# Supported providers: claude-code, codex, openai-compatible, openai.
RESEARCH_LLM_PROVIDER=codex
# Codex starts an isolated local MCP server by default; set this only when you
# want to override the model passed to the codex MCP tool.
# RESEARCH_LLM_MODEL=gpt-5.4
# Local Qwen OpenAI-compatible server:
# Start separately with:
# python -m packages.research.qwen_openai_server --host 127.0.0.1 --port 8001
# QWEN_MODEL_ID=Qwen/Qwen3-1.7B
# RESEARCH_LLM_PROVIDER=openai-compatible
# RESEARCH_LLM_MODEL=Qwen/Qwen3-1.7B
# RESEARCH_LLM_BASE_URL=http://127.0.0.1:8001/v1
# RESEARCH_LLM_API_KEY=EMPTY
# Claude Code alternative:
# RESEARCH_LLM_PROVIDER=claude-code
# RESEARCH_LLM_MODEL=claude-sonnet-4-5
# Optional: point at a custom persistent JSONL wrapper around Claude Code/Codex.
# RESEARCH_LLM_COMMAND=/path/to/local-model-jsonl-wrapper
# RESEARCH_LLM_PROTOCOL=jsonl
# RESEARCH_LLM_TIMEOUT=120

# Optional OpenAI fallback. Used only when RESEARCH_LLM_PROVIDER=openai.
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=<your-openai-org-id>
# OPENAI_PROJECT_ID=<your-openai-project-id>

# Modal
MODAL_TOKEN_ID=<your-modal-token-id>
MODAL_TOKEN_SECRET=<your-modal-token-secret>
GVHMR_MODAL_APP_NAME=gvhmr-probe
GVHMR_MODAL_FUNCTION_NAME=run_probe

# Gemini Model (for orchestrator)
GEMINI_MODEL=gemini-2.5-pro

# App
NEXT_PUBLIC_API_URL=http://localhost:8000
EVOLUTION_ARTIFACTS_DIR=/tmp/il_ideation/evolutions

# Prompt/query persistence
PROMPT_PERSISTENCE_ENABLED=true
PROMPT_QUERIES_TABLE=PromptQueries
# Optional overrides. If unset, SUPABASE_URL and SUPABASE_SERVICE_KEY are used.
# PROMPT_SUPABASE_URL=https://<your-project-ref>.supabase.co
# PROMPT_SUPABASE_SERVICE_KEY=<your-service-role-key>

# LangSmith observability
LANGSMITH_ENABLED=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=il-ideation

# RoboGrammar database
GRAMMAR_TABLE=Grammars
GRAMMAR_NODES_TABLE=GrammarNodes
GRAMMAR_NODE_MEMBERSHIPS_TABLE=GrammarNodeMemberships
STRUCTURAL_RULES_TABLE=StructuralRules
GRAMMAR_NODES_LIMIT=200
STRUCTURAL_RULES_LIMIT=100
GRAMMAR_ACTIVE_ONLY=true
# Optional Supabase overrides. If unset, SUPABASE_URL and a Supabase key are used.
# GRAMMAR_SUPABASE_URL=https://<your-project-ref>.supabase.co
# GRAMMAR_SUPABASE_SERVICE_KEY=<your-service-role-key>
# GRAMMAR_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Photon / Spectrum (iMessage HITL)
PHOTON_PROJECT_ID=<your-spectrum-project-id>
PHOTON_SECRET_KEY=<your-spectrum-secret-key>
# Optional: Set to 1 for local testing without real iMessage
# PHOTON_MOCK_MODE=1
