<mujoco model="target_reaching_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint damping="2" armature="0.05"/>
    <geom density="600" rgba="0.25 0.48 0.80 1"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.05" rgba="0.18 0.18 0.20 1"/>
    <body name="arm" pos="0 0 0.5">
      <joint name="shoulder" type="hinge" axis="0 0 1" range="-1.57 1.57"/>
      <geom name="arm_link" type="capsule" fromto="0 0 0 0.8 0 0" size="0.035"/>
      <site name="end_effector" pos="0.8 0 0" size="0.025" rgba="0.95 0.30 0.20 1"/>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_position" joint="shoulder" kp="60" ctrlrange="-1.57 1.57" forcerange="-20 20"/>
  </actuator>
</mujoco>
