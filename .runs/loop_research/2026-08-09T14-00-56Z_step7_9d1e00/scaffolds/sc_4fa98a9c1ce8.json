  "task_text": "lift the payload to shelf height",
  "reward_terms": [
    {
      "name": "height_progress",
      "weight": 2.0,
      "expression": "max(0, site.payload_center.pos.z - 0.1)",
      "symbols": [
        "site.payload_center.pos.z"
      ],
      "rationale": "Reward lifting payload above initial resting height"
    },
    {
      "name": "shelf_approach",
      "weight": 1.5,
      "expression": "-abs(site.payload_center.pos.z - site.shelf_target.pos.z)",
      "symbols": [
        "site.payload_center.pos.z",
        "site.shelf_target.pos.z"
      ],
      "rationale": "Penalize distance from target shelf height to encourage precise reach"
    },
    {
      "name": "success_bonus",
      "weight": 3.0,
      "expression": "max(0, min(site.payload_center.pos.z - site.shelf_target.pos.z + 0.1, 0.1))",
      "symbols": [
        "site.payload_center.pos.z",
        "site.shelf_target.pos.z"
      ],
      "rationale": "Bonus when payload reaches and stays within 10cm of shelf target"
    },
    {
      "name": "grip_maintenance",
      "weight": 4.0,
      "expression": "sensor.s_touch_left",
      "symbols": [
        "sensor.s_touch_left"
      ],
      "rationale": "Maintain strong contact with payload; weight increased 5x due to consistent grip loss"
    },
    {
      "name": "grip_security",
      "weight": 3.0,
      "expression": "-max(0, 0.2 - sensor.s_touch_left)",
      "symbols": [
        "sensor.s_touch_left"
      ],
      "rationale": "Penalize grip sensor falling below 0.2 safety threshold; catches degradation before termination at 0.1"
    },
    {
      "name": "motion_smoothness",
      "weight": 0.1,
      "expression": "-abs(joint.j_shoulder.qvel) - abs(joint.j_elbow.qvel) - abs(joint.j_wrist.qvel) - abs(joint.j_base_yaw.qvel)",
      "symbols": [
        "joint.j_shoulder.qvel",
        "joint.j_elbow.qvel",
        "joint.j_wrist.qvel",
        "joint.j_base_yaw.qvel"
      ],
      "rationale": "Penalize high joint velocities to encourage controlled motion"
    }
  ],
  "terminations": [
    {
      "name": "grip_lost",
      "predicate": "sensor.s_touch_left < 0.1",
      "symbols": [
        "sensor.s_touch_left"
      ],
      "cause_label": "Payload dropped due to loss of grip contact"
    },
    {
      "name": "task_success",
      "predicate": "site.payload_center.pos.z >= site.shelf_target.pos.z - 0.05",
      "symbols": [
        "site.payload_center.pos.z",
        "site.shelf_target.pos.z"
      ],
      "cause_label": "Payload successfully lifted to shelf height"
    },
    {
      "name": "payload_fallen",
      "predicate": "site.payload_center.pos.z < 0.08",
