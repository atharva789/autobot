  "task_text": "lift the payload to shelf height",
  "reward_terms": [
    {
      "name": "height_tracking",
      "weight": 1.0,
      "expression": "-abs(body.payload.pos.z - site.shelf_target.pos.z)",
      "symbols": [
        "body.payload.pos.z",
        "site.shelf_target.pos.z"
      ],
      "rationale": "Primary objective: minimize vertical distance between payload and shelf target height"
    },
    {
      "name": "grasp_contact",
      "weight": 0.1,
      "expression": "sensor.s_touch_left",
      "symbols": [
        "sensor.s_touch_left"
      ],
      "rationale": "Maintain gripper contact with payload; touch sensor indicates successful grasp during lift"
    },
    {
      "name": "action_efficiency",
      "weight": 0.01,
      "expression": "-(abs(actuator.m_shoulder.ctrl) + abs(actuator.m_elbow.ctrl) + abs(actuator.m_wrist.ctrl))",
      "symbols": [
        "actuator.m_shoulder.ctrl",
        "actuator.m_elbow.ctrl",
        "actuator.m_wrist.ctrl"
      ],
      "rationale": "Penalize excessive control magnitude in arm actuators to encourage smooth, efficient motion"
    },
    {
      "name": "upward_motion_bonus",
      "weight": 0.05,
      "expression": "max(0, joint.j_shoulder.qvel) + max(0, joint.j_elbow.qvel)",
      "symbols": [
        "joint.j_shoulder.qvel",
        "joint.j_elbow.qvel"
      ],
      "rationale": "Encourage positive velocity in primary lifting joints; only reward upward motion"
    }
  ],
  "terminations": [
