  "task_text": "lift the payload to shelf height",
  "reward_terms": [
    {
      "name": "reaching_payload",
      "weight": 1.0,
      "expression": "-max(abs(site.grip_center.pos.x - site.payload_center.pos.x), abs(site.grip_center.pos.y - site.payload_center.pos.y), abs(site.grip_center.pos.z - site.payload_center.pos.z))",
      "symbols": [
        "site.grip_center.pos.x",
        "site.grip_center.pos.y",
        "site.grip_center.pos.z",
        "site.payload_center.pos.x",
        "site.payload_center.pos.y",
        "site.payload_center.pos.z"
      ],
      "rationale": "Minimize L-infinity distance between gripper and payload center. Drives initial reaching behavior to establish contact before grasping."
    },
    {
      "name": "grasping",
      "weight": 0.8,
      "expression": "sensor.s_touch_left",
      "symbols": [
        "sensor.s_touch_left"
      ],
      "rationale": "Reward left finger contact force. Encourages maintaining finger grip during lift to prevent payload drop."
    },
    {
      "name": "lifting_to_target",
      "weight": 2.0,
      "expression": "-abs(body.payload.pos.z - site.shelf_target.pos.z)",
      "symbols": [
        "body.payload.pos.z",
        "site.shelf_target.pos.z"
      ],
      "rationale": "Primary objective: minimize height error from target shelf position. Highest weight drives the core task completion."
    },
    {
      "name": "control_efficiency",
      "weight": -0.01,
      "expression": "abs(actuator.m_elbow.force) + abs(actuator.m_wrist.force)",
      "symbols": [
        "actuator.m_elbow.force",
        "actuator.m_wrist.force"
      ],
      "rationale": "Soft penalty on arm actuator effort. Encourages smooth, economical lifting without excessive force."
    }
  ],
  "terminations": [
    {
      "name": "success_at_shelf",
      "predicate": "abs(body.payload.pos.z - site.shelf_target.pos.z) < 0.05",
      "symbols": [
        "body.payload.pos.z",
        "site.shelf_target.pos.z"
      ],
      "cause_label": "task_success"
    },
    {
