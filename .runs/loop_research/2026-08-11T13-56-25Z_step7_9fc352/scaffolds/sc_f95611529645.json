  "task_text": "lift the payload to shelf height",
  "reward_terms": [
    {
      "name": "position_alignment",
      "weight": 1.0,
      "expression": "-(abs(site.grip_center.pos.x - site.payload_center.pos.x) + abs(site.grip_center.pos.y - site.payload_center.pos.y) + abs(site.grip_center.pos.z - site.payload_center.pos.z))",
      "symbols": [
        "site.grip_center.pos.x",
        "site.payload_center.pos.x",
        "site.grip_center.pos.y",
        "site.payload_center.pos.y",
        "site.grip_center.pos.z",
        "site.payload_center.pos.z"
      ],
      "rationale": "L1 distance from gripper to payload; agent minimizes error in approach"
    },
    {
      "name": "grip_contact",
      "weight": 2.0,
      "expression": "sensor.s_touch_jaw",
      "symbols": [
        "sensor.s_touch_jaw"
      ],
      "rationale": "Maximize touch sensor feedback when gripping payload"
    },
    {
      "name": "lift_height",
      "weight": 5.0,
      "expression": "max(site.payload_center.pos.z - site.shelf_target.pos.z, 0)",
      "symbols": [
        "site.payload_center.pos.z",
        "site.shelf_target.pos.z"
      ],
      "rationale": "Reward payload height above shelf target; zero below target"
    },
    {
      "name": "control_efficiency",
      "weight": 0.05,
      "expression": "-(abs(actuator.a_x) + abs(actuator.a_y) + abs(actuator.a_z) + abs(actuator.a_jaw))",
      "symbols": [
        "actuator.a_x",
        "actuator.a_y",
        "actuator.a_z",
        "actuator.a_jaw"
      ],
      "rationale": "Minimize actuator effort to encourage smooth, efficient motion"
    }
  ],
  "terminations": [
    {
      "name": "task_success",
      "predicate": "site.payload_center.pos.z >= site.shelf_target.pos.z",
      "symbols": [
        "site.payload_center.pos.z",
        "site.shelf_target.pos.z"
      ],
      "cause_label": "lift_complete"
    },
    {
      "name": "payload_lost",
      "predicate": "joint.j_payload_free.qpos >= 0.5",
      "symbols": [
        "joint.j_payload_free.qpos"
      ],
      "cause_label": "grip_failed"
    }
  ],
