  "task_text": "lift the payload to shelf height",
  "reward_terms": [
    {
      "name": "height_bonus",
      "weight": 1.5,
      "expression": "max(0, body.payload.pos.z - 0.05) / 0.4",
      "symbols": [
        "body.payload.pos.z"
      ],
      "rationale": "Reward lifting payload above ground level. Normalized by expected maximum reach height of ~0.4m."
    },
    {
      "name": "shelf_target_bonus",
      "weight": 2.0,
      "expression": "max(0, 1 - abs(body.payload.pos.z - site.shelf_target.pos.z) / 0.05)",
      "symbols": [
        "body.payload.pos.z",
        "site.shelf_target.pos.z"
      ],
      "rationale": "High reward when payload height matches shelf target within 5cm tolerance. Dense shaping at the goal."
    },
    {
      "name": "reach_payload",
      "weight": 1.0,
      "expression": "-(abs(site.grip_center.pos.x - site.payload_center.pos.x) + abs(site.grip_center.pos.y - site.payload_center.pos.y) + abs(site.grip_center.pos.z - site.payload_center.pos.z)) / 1.5",
      "symbols": [
        "site.grip_center.pos.x",
        "site.grip_center.pos.y",
        "site.grip_center.pos.z",
        "site.payload_center.pos.x",
        "site.payload_center.pos.y",
        "site.payload_center.pos.z"
      ],
      "rationale": "Shaping reward to move gripper toward payload center. Manhattan distance normalized by arm reach."
    },
    {
      "name": "gripper_closure",
      "weight": 0.8,
      "expression": "joint.j_finger_left.qpos + joint.j_finger_right.qpos",
      "symbols": [
        "joint.j_finger_left.qpos",
        "joint.j_finger_right.qpos"
      ],
      "rationale": "Encourage finger closure. Assumes positive qpos values correspond to closed gripper state."
    },
    {
      "name": "touch_on_closure",
      "weight": 1.0,
      "expression": "sensor.s_touch_left * min(joint.j_finger_left.qpos + joint.j_finger_right.qpos, 1.0)",
      "symbols": [
        "sensor.s_touch_left",
        "joint.j_finger_left.qpos",
        "joint.j_finger_right.qpos"
      ],
      "rationale": "Bonus for contact with object during closure. Touch sensor gates gripper reward to establish grasping constraint."
    },
    {
      "name": "control_efficiency",
      "weight": -0.1,
      "expression": "abs(actuator.m_base_yaw.force) + abs(actuator.m_shoulder.force) + abs(actuator.m_elbow.force) + abs(actuator.m_wrist.force)",
      "symbols": [
        "actuator.m_base_yaw.force",
        "actuator.m_shoulder.force",
        "actuator.m_elbow.force",
        "actuator.m_wrist.force"
      ],
      "rationale": "Penalize excessive actuator force to encourage smooth, energy-efficient motion."
    }
  ],
  "terminations": [
    {
      "name": "task_success",
      "predicate": "body.payload.pos.z >= site.shelf_target.pos.z - 0.02",
      "symbols": [
        "body.payload.pos.z",
