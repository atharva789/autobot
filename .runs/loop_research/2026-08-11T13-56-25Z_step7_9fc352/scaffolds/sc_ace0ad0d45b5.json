      "weight": 0.5,
      "expression": "sensor.s_touch_left",
      "symbols": [
        "sensor.s_touch_left"
      ],
      "rationale": "Increased weight to reward and maintain sustained tactile contact with payload during lift; asymmetric contact and grip loss indicate touch reward was too weak to prioritize contact stability"
    },
    {
      "name": "motion_smoothness",
      "weight": 0.15,
      "expression": "-(abs(joint.j_elbow.qvel) + abs(joint.j_shoulder.qvel) + abs(joint.j_wrist.qvel)) * 0.33",
      "symbols": [
        "joint.j_elbow.qvel",
        "joint.j_shoulder.qvel",
        "joint.j_wrist.qvel"
      ],
      "rationale": "Slight increase to encourage smoother, more controlled arm motions that reduce payload disturbance and help maintain grip stability"
    },
    {
      "name": "base_stability",
      "weight": 0.05,
      "expression": "-abs(joint.j_base_yaw.qpos)",
      "symbols": [
        "joint.j_base_yaw.qpos"
      ],
      "rationale": "Minimize unnecessary base rotation to maintain platform stability and energy efficiency during manipulation"
    }
  ],
