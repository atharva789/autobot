      "expression": "-(max(0, joint.j_finger_left.qpos) + max(0, joint.j_finger_right.qpos))",
      "symbols": [
        "joint.j_finger_left.qpos",
        "joint.j_finger_right.qpos"
      ],
      "rationale": "Increased weight to enforce secure grip before lift; grip loss is preventing all episodes from progressing. Gripper must be strong enough to compete with height objective."
    },
