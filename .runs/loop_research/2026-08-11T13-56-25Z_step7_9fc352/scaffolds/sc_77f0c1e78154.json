  "task_text": "lift the payload to shelf height",
  "reward_terms": [
    {
      "name": "height_to_shelf",
      "weight": 2.0,
      "expression": "-abs(site.payload_center.pos.z - site.shelf_target.pos.z)",
      "symbols": [
        "site.payload_center.pos.z",
        "site.shelf_target.pos.z"
      ],
      "rationale": "Primary objective: minimize vertical distance between payload and shelf target. Continuous gradient guides the arm upward."
    },
    {
      "name": "grip_stability",
      "weight": 1.0,
      "expression": "sensor.s_touch_left",
      "symbols": [
        "sensor.s_touch_left"
      ],
      "rationale": "Maintain contact throughout lift. Without grip, payload falls and task fails. Sensor directly measures gripper contact state."
    },
    {
      "name": "payload_centering",
      "weight": 0.5,
      "expression": "-(abs(site.payload_center.pos.x - site.grip_center.pos.x) + abs(site.payload_center.pos.y - site.grip_center.pos.y)) / 10",
      "symbols": [
        "site.payload_center.pos.x",
        "site.payload_center.pos.y",
        "site.grip_center.pos.x",
        "site.grip_center.pos.y"
      ],
      "rationale": "Prevent tilting by keeping payload aligned under gripper centerline. Lateral misalignment destabilizes the lift."
    },
    {
      "name": "motion_smoothness",
      "weight": -0.1,
      "expression": "abs(joint.j_shoulder.qvel) + abs(joint.j_elbow.qvel) + abs(joint.j_wrist.qvel) + abs(joint.j_base_yaw.qvel)",
      "symbols": [
        "joint.j_shoulder.qvel",
        "joint.j_elbow.qvel",
        "joint.j_wrist.qvel",
        "joint.j_base_yaw.qvel"
      ],
      "rationale": "Penalize high joint velocities to encourage smooth, controlled motion. Reduces energy consumption and improves transferability."
    }
  ],
  "terminations": [
    {
      "name": "success",
      "predicate": "abs(site.payload_center.pos.z - site.shelf_target.pos.z) < 0.02",
      "symbols": [
        "site.payload_center.pos.z",
        "site.shelf_target.pos.z"
      ],
      "cause_label": "task_success"
    },
    {
      "name": "grip_lost",
      "predicate": "sensor.s_touch_left < 0.1",
      "symbols": [
        "sensor.s_touch_left"
      ],
      "cause_label": "dropped_payload"
    }
  ],
  "curriculum": [
