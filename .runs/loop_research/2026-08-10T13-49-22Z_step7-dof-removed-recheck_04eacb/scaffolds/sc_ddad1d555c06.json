    {
      "name": "shelf_height_reach",
      "weight": 10.0,
      "expression": "max(0, 1 - 5 * abs(site.payload_center.pos.z - site.shelf_target.pos.z))",
      "symbols": [
        "site.payload_center.pos.z",
        "site.shelf_target.pos.z"
