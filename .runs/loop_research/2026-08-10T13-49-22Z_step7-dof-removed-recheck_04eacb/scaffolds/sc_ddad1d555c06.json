      "symbols": [
        "sensor.s_touch_left"
      ],
      "rationale": "Encourage and maintain finger contact with payload; essential prerequisite for any lifting"
    },
    {
      "name": "horizontal_alignment",
      "weight": 1.0,
      "expression": "-(abs(site.payload_center.pos.x - site.shelf_target.pos.x) + abs(site.payload_center.pos.y - site.shelf_target.pos.y))",
      "symbols": [
        "site.payload_center.pos.x",
        "site.payload_center.pos.y",
        "site.shelf_target.pos.x",
        "site.shelf_target.pos.y"
      ],
      "rationale": "Penalty for horizontal misalignment; guides agent to position payload directly above shelf_target before lifting"
    }
